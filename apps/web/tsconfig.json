{
  "extends": "../../packages/config/typescript/react.json",
  "compilerOptions": {
    "composite": true,
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
